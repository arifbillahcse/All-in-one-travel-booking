APP_NAME=TravelOrio
APP_ENV=production
APP_KEY=                      # php artisan key:generate --force  (once; never change later)
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=https://travelorio.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=travelorio
DB_USERNAME=travelorio
DB_PASSWORD=change-me-long-random

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=database       # needs `php artisan queue:work` (see deploy/supervisor-queue.conf)
FILESYSTEM_DISK=local

# Behind Cloudflare / a load balancer: "*" or the proxy IPs, so https and client IPs are detected
TRUSTED_PROXIES=*

# Real email (inquiry notifications, password resets)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@travelorio.com"
MAIL_FROM_NAME="${APP_NAME}"

# Set true on staging so search engines stay away
SITE_NOINDEX=false

# Backups (nightly 02:30). BACKUP_DISK = a filesystem disk (e.g. s3) for an off-server copy
BACKUP_KEEP=14
# BACKUP_PATH=/var/backups/travelorio
# BACKUP_DISK=s3

VITE_APP_NAME="${APP_NAME}"

# Business details (also editable later in the admin panel > Settings)
TRAVELORIO_EMAIL=hello@travelorio.com
TRAVELORIO_NOTIFY_EMAIL=bookings@travelorio.com
TRAVELORIO_WHATSAPP=8801779440297
TRAVELORIO_PHONE="+8801779440297"
TRAVELORIO_PHONE_DISPLAY="+880 1779-440297"
TRAVELORIO_FACEBOOK="https://facebook.com/yourpage"
TRAVELORIO_INSTAGRAM="https://instagram.com/yourpage"
TRAVELORIO_YOUTUBE="https://youtube.com/@yourchannel"
